# Скопируйте в .env.local (он не попадает в git) и заполните ключами DEV-проектов.
# На Cloudflare Pages те же переменные задаются в настройках проекта (отдельно для Production и Preview).

# Supabase → Project Settings → API (Data API): Project URL и anon / publishable key
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=

# PostHog → Project settings → Project API key (phc_…). Пусто — аналитика выключена.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://eu.i.posthog.com

# Cloudflare Turnstile (капча на вход/регистрацию): Site key. Пусто — капчи нет.
VITE_TURNSTILE_SITE_KEY=

# production | staging
VITE_APP_ENV=staging

# Принудительно включённые функции для этой сборки, через запятую: qrScan,pro
VITE_FEATURES=

# Бэкенд-прокси для загрузки фискальных чеков (см. src/features/receipt-scan/receiptService.ts)
VITE_RECEIPT_API_URL=
